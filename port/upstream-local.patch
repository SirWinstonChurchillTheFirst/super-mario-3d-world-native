+std::vector<RealRemote> g_real_remotes;
+
+void close_remote(RealRemote& r) {
+    for (int* fd : {&r.keys, &r.accel, &r.ir, &r.nunchuk, &r.mp}) {
+        if (*fd >= 0) close(*fd);
+        *fd = -1;
+    }
