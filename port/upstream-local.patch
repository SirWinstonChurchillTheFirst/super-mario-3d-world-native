+void attitude_from_acc(os::WiimoteState& w) {
+    w.pitch = std::asin(std::clamp(w.acc[2] / std::max(0.2f, std::sqrt(w.acc[0] * w.acc[0] + w.acc[1] * w.acc[1] + w.acc[2] * w.acc[2])), -1.0f, 1.0f));
+    w.roll = std::atan2(w.acc[0], -w.acc[1]);
