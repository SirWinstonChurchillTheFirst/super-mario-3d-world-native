+// port/patch_stall_trace.py: a frame of the draw thread over 60 ms, and what took the time in it.
+void Renderer::trace_stall_frame() {
+    static double last = 0, wait0 = 0;
+    static Spent tr0{}, co0{}, pi0{}, te0{}, up0{};
+    static uint64_t targets0 = 0;
+    const double now = now_seconds();
+    // the Spent counters restart every 10 s (statistics line): a smaller value is a new window
+    const auto delta = [](const Spent& now_s, const Spent& then) {
+        return (now_s.seconds >= then.seconds ? now_s.seconds - then.seconds : now_s.seconds) * 1000.0;
+    };
+    const double waited = wait_seconds_ >= wait0 ? wait_seconds_ - wait0 : wait_seconds_;
+    static const double stall_s = [] { // port/patch_stall_ms.py
+        const char* v = std::getenv("TTT2_STALL_MS");
+        return v ? std::atof(v) / 1000.0 : 0.06;
+    }();
+    if (last != 0 && now - last > stall_s) {
+        std::fprintf(stderr,
+                     "stall-cp: %.3f frame %llu %.0f ms: images %u made in %.1f ms (%.1f MB), textures new %u, targets new %llu, "
+                     "submits %u in %.1f ms, GPU waits %.1f ms, translate %.1f ms, compile %.1f ms, pipelines %.1f ms, "
+                     "texture binds %.1f ms, uploads %.1f ms\n",
+                     now, static_cast<unsigned long long>(frame_number_), (now - last) * 1000.0, stall_.images,
+                     stall_.image_s * 1000.0, stall_.image_mb, stall_.textures,
+                     static_cast<unsigned long long>(target_generation_ - targets0), stall_.submits, stall_.submit_s * 1000.0,
+                     waited * 1000.0, delta(spent_translate_, tr0), delta(spent_compile_, co0), delta(spent_pipeline_, pi0),
+                     delta(spent_texture_, te0), delta(spent_upload_, up0));
+    }
+    last = now;
+    wait0 = wait_seconds_;
+    tr0 = spent_translate_;
+    co0 = spent_compile_;
+    pi0 = spent_pipeline_;
+    te0 = spent_texture_;
+    up0 = spent_upload_;
+    targets0 = target_generation_;
+    stall_ = {};
+}
