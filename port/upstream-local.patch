+// A host pad as a Wii Remote held upright with a Nunchuk (see the patch's header for the buttons).
+struct PadMotion {
+    double shake_phase = 0.0, nunchuk_phase = 0.0;
+    float tilt_x = 0.0f, tilt_y = 0.0f;
+    float pointer_x = 0.0f, pointer_y = 0.0f;
