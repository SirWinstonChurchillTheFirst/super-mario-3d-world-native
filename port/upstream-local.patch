+// port/patch_gs.py: geometry mode rings.
+void Translator::emit_ring_write(const CfInstruction& cf) {
+    const ExportInstruction& e = cf.exp;
+    if (e.type != 0) {
+        fail("indexed ring write");
+        return;
+    }
+    if (e.array_base % 4 != 0) {
+        fail(format("ring write at dword %u (not a vec4)", e.array_base));
+        return;
+    }
+    for (uint32_t b = 0; b <= e.burst_count; ++b) {
+        const uint32_t slot = e.array_base / 4 + b;
+        if (es_ && slot >= env_.esgs_slots) {
+            fail(format("ES ring write to vec4 %u beyond the item size %u", slot, env_.esgs_slots));
+            return;
+        }
+        const std::string reg = gpr(e.rw_gpr + b, e.rw_rel, kLoopIndex);
+        for (int i = 0; i < 4; ++i) {
+            if (!(e.comp_mask & (1u << i))) continue;
+            line(format("if (act) %s[%u].%c = %s.%c;", es_ ? "esgs_out" : "gsvs_ring", slot, kChan[i], reg.c_str(), kChan[i]));
+        }
+        if (gs_) gs_ring_slots_ = std::max(gs_ring_slots_, slot + 1);
+    }
+}
+
+void Translator::emit_ring_read(const VtxInstruction& v, bool copy) {
+    open("");
+    line(format("uint ra = uint(%s.%c) + %uu;", gpr(v.src_gpr, v.src_rel, kLoopIndex).c_str(), kChan[v.src_sel_x & 3],
+                v.offset));
+    if (copy) {
+        line(format("ivec4 f = gsvs_ring[clamp(gs_emit * %u + int((ra & 0xFFFFFu) >> 4u), 0, gsvs_ring.length() - 1)];",
+                    std::max<uint32_t>(env_.gsvs_vertex_slots, 1)));
+    } else {
+        line(format("ivec4 f = esgs_in[min(int(ra >> 20u), %d)][min(int((ra & 0xFFFFFu) >> 4u), %d)];",
+                    std::max<int>(env_.gs_in_vertices, 1) - 1, std::max<int>(env_.esgs_slots, 1) - 1));
+    }
+    const int dst = v.semantic_or_gpr;
+    for (int i = 0; i < 4; ++i) {
+        const uint8_t sel = v.dst_sel[i];
+        if (sel == kSelMask) continue;
+        const std::string value = sel < 4 ? format("f.%c", kChan[sel]) : sel == kSel1 ? "0x3F800000" : "0";
+        line(gpr_store(dst, v.dst_rel, kLoopIndex, kChan[i], value));
+    }
+    close();
+}
+
+bool Translator::run_gs(const Program& copy, const ShaderEnvironment& copy_env, std::string& error) {
+    TranslatedShader copy_out;
+    Translator c(copy, nullptr, copy_env, copy_out);
+    std::string copy_error;
+    if (!c.run(copy_error)) {
+        error = "copy shader: " + copy_error;
+        return false;
+    }
+    if (c.relative_ || !copy.subroutines.empty() || c.texture_mask_ || c.uses_registers_ || c.constant_bank_mask_ ||
+        c.buffer_mask_ || c.uses_kill_) {
+        error = "copy shader with features the geometry path lacks";
+        return false;
+    }
+    if (!run(error)) return false;
+    if (texture_mask_ || uses_registers_ || buffer_mask_) {
+        error = "geometry shader with textures, uniform registers or buffers";
+        return false;
+    }
+    bool loops = !p_.subroutines.empty();
+    for (const CfInstruction& cf : p_.cf) {
+        if (cf.kind == CfInstruction::kNormal && (cf.inst == cf::kLoopStart || cf.inst == cf::kLoopStartDx10 ||
+                                                  cf.inst == cf::kLoopStartNoAl || cf.inst == cf::kCall)) {
+            loops = true;
+        }
+    }
+    uint32_t outputs = 1; // position
+    for (int k = 0; k < env_.ps_input_count; ++k) {
+        if (k == env_.ps_position_input) continue;
+        bool exported = false;
+        for (uint8_t s : env_.vs_out_semantic) exported |= s == env_.ps_inputs[k].semantic && s != 0xFF;
+        if (exported) ++outputs;
+    }
+    const uint32_t by_components = std::max<uint32_t>(1, 1024 / (4 * outputs));
+    const uint32_t max_vertices = std::min<uint32_t>(256, loops || gs_emits_ == 0 ? by_components : std::min(gs_emits_, by_components));
+    const uint32_t stride = std::max<uint32_t>(env_.gsvs_vertex_slots, 1);
+    const uint32_t ring = std::max<uint32_t>({gs_ring_slots_, max_vertices * stride, 1});
+    static constexpr const char* kIn[] = {"points", "lines", "triangles"};
+    static constexpr const char* kOut[] = {"points", "line_strip", "triangle_strip"};
+    std::string g = header();
+    g += format("layout(%s) in;\nlayout(%s, max_vertices = %u) out;\n", kIn[std::clamp<int>(env_.gs_in_vertices, 1, 3) - 1],
+                kOut[std::min<int>(env_.gs_out_prim, 2)], max_vertices);
+    g += format("layout(location = 0) in ivec4 esgs_in[][%u];\n", std::max<uint32_t>(env_.esgs_slots, 1));
+    g += pieces_.globals;
+    g += format("ivec4 gsvs_ring[%u];\nint gs_emit = 0;\n\n", ring);
+    g += "void copy_vertex() {\n";
+    for (size_t pos = 0; pos < c.pieces_.globals.size();) { // the copy shader's registers, as locals
+        const size_t end = c.pieces_.globals.find('\n', pos);
+        g += "    " + c.pieces_.globals.substr(pos, end - pos) + "\n";
+        pos = end == std::string::npos ? c.pieces_.globals.size() : end + 1;
+    }
+    g += c.pieces_.init + c.pieces_.vars + c.pieces_.body + "}\n\n";
+    g += pieces_.functions;
+    g += "void main() {\n" + pieces_.init + pieces_.vars + pieces_.body + "}\n";
+    out_.glsl = g;
+    return true;
+}
