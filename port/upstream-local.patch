+    for (size_t i = 0; i < 0x60; i += 2) put16(i, 1);
+    put16(0x3A, 1 | (3 << 9));
+    put16(0x02, 1 | (1 << 12));
+    m[0x08] = 0x00; m[0x09] = 0x03; m[0x0A] = 0x33; m[0x0B] = 0x34; // id low 0x33334
+    for (size_t i = 0; i < 0x60; i += 2) std::swap(m[i], m[i + 1]); // the fields are stored little-endian
