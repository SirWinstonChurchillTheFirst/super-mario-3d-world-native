+// port/patch_wiimote_mpls.py: MotionPlus switch and the attitude from gravity (a remote at rest)
+bool wiimote_mplus() {
+    static const bool on = [] {
+        const char* v = std::getenv("CAFE_WIIMOTE_MPLUS");
+        return v == nullptr || *v != '0';
+    }();
+    return on;
